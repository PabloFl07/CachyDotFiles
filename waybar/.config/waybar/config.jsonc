{
        "layer": "top",
        "position": "top",
        "reload_style_on_change": true,
        "modules-left": ["custom/notification","custom/apps","clock", "custom/cava_media", "mpris"],
        "modules-center": ["hyprland/workspaces", "custom/pacman"],
        "modules-right": ["group/expand","bluetooth","network", "battery", "custom/power"],


        "hyprland/workspaces": {
            "format": "{icon}",
            "format-icons": {
                "active": "",
                "default": "",
                "empty": ""
            },
            "persistent-workspaces": {
                "*": [ 1,2,3,4,5 ]
            }
        },
        "custom/notification": {
            "tooltip": false,
            "format": "",
            "on-click": "swaync-client -t -sw",
            "escape": true
        },
        "clock": {
            "format": "{:%I:%M} ",
            "format-alt": "{:%d/%m} ",
            "interval": 1,   
            "tooltip-format": "<tt>{calendar}</tt>",
            "calendar": {
                "format": {
                    "today": "<span color='#A16B57'><b>{}</b></span>"
                }
            },
            "actions": {
                "on-scroll-up": "shift_up",
                "on-scroll-down": "shift_down",
                "on-click": "mode"
            }
        },
        "network": {
            "format-wifi": "{ipaddr}  ",
            "format-ethernet":"{ipaddr} 🖧",
            "format-disconnected": "",
            "tooltip-format-disconnected": "Error",
            "tooltip-format-wifi": "{essid} ({signalStrength}%) ",
            "tooltip-format-ethernet": "{ifname} 🖧 ",
            "on-click": "kitty nmtui"
        },
        "bluetooth": {
            "format-on": "󰂯",
            "format-off": "󰂲",
            "format-disabled": "󰂲",
            "format-connected-battery": "󰂯",
            "format-alt": "{device_alias} 󰂯",
            "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
            "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
            "tooltip-format-enumerate-connected": "{device_alias}\n{device_address}",
            "tooltip-format-enumerate-connected-battery": "{device_alias}\n{device_address}\n{device_battery_percentage}%",
            "on-click-right": "blueman-manager"
        }, 
        "battery": {
            "interval":15,
            "states": {
                "good": 95,
                "warning": 30,
                "critical": 20
            },
            "format": "{capacity}% {icon}",
            "format-charging": "{capacity}% 󰂄",
            "format-plugged": "{capacity}% 󰂄 ",
            "format-alt": "{time} {icon}",
            "format-icons": [
                "󰁻",
            "󰁼",
            "󰁾",
            "󰂀",
            "󰂂",
            "󰁹"
            ]
        },

        "custom/apps": {
            "format": "",
            "tooltip": false,
            "on-click": "~/.config/rofi/type-1/launcher.sh"
        },

        "custom/pacman": {
            "format": "󰅢 {}",
            "interval": 30,   
            "exec": "checkupdates | wc -l",
            "exec-if": "exit 0",
            "on-click": "kitty sh -c 'yay -Syu && echo \"Done - Press enter to exit\" || echo \"ERROR - Press enter to exit\"'; read; pkill -SIGRTMIN+8 waybar",
            "on-click-right": "xdg-open https://archlinux.org/news/",
            "signal": 8,
            "tooltip": false
        },
        "custom/expand": {
            "format": " ",
            "tooltip": false
        },
        "custom/endpoint":{
            "format": "|",
            "tooltip": false
        },
        "group/expand": {
            "orientation": "horizontal",
            "drawer": {
                "transition-duration": 600,
                "transition-to-left": true,
                "click-to-reveal": true
            },
            "modules": ["custom/expand","cpu","memory","temperature","custom/endpoint"]
        },
        "cpu": {
            "format": " {usage}%",
            "tooltip": true
        },
        "memory": {
            "format": " {used}Gb",
            "tooltip": true
        },
        "temperature": {
            "critical-threshold": 80,
            "format": " {temperatureC}°C",
            "tooltip": true
        },
        "tray": {
            "icon-size": 14,
            "spacing": 10
        },
        "custom/cava_media": {
            "exec": "~/.config/waybar/scripts/cava-media.sh",
            "format": "{}",
            "escape": true,
            "tooltip": false,
            "on-click": "playerctl play-pause",
            "on-scroll-up": "playerctl next",
            "on-scroll-down": "playerctl previous"
        },
        "mpris": {
            "format": "{status_icon} {artist} - {title}",
            "format-paused": "{status_icon} <i>{artist} - {title}</i>",
            "player-icons": {
                "spotify": "",
                "firefox": "󰈹"
                },
            "status-icons": {
                "playing": "󰏤",
                "paused": "󰐊"
                },
            "max-length": 35,
            "ellipsis": "...",
            "on-click": "playerctl play-pause",
            "on-scroll-up": "playerctl next",
            "on-scroll-down": "playerctl previous"
        },
        "custom/power": {
            "format": "⏻ ",
            "tooltip": false,
            "on-click": "~/.config/rofi/powermenu/powermenu.sh"
    } 
}

